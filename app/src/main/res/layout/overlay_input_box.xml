<?xml version="1.0" encoding="utf-8"?>
<!--
    Assistant text input overlay ("Ask Delta").

    Material's TextInputLayout supplies the outline, floating hint, cursor
    colour and focus transition, replacing the hand-rolled selector drawable
    this used to depend on. 28dp corners and a 56dp minimum height match the
    assistant input elsewhere.

    IDs (overlayRootLayout / overlayInputField) are load-bearing -
    VisualFeedbackManager looks both up by id.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/overlayInputLayout"
        style="@style/Assistant.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/input_box_hint"
        app:boxCornerRadiusBottomEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusTopStart="28dp"
        app:endIconMode="clear_text"
        app:hintEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/overlayInputField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="4"
            android:minHeight="56dp"
            android:textColor="@color/assistant_on_surface"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Outline stroke for the assistant input overlay: the quiet default border at
    rest, the accent once focused, matching how the old input_box_background
    selector behaved.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="@color/assistant_primary"
        android:state_focused="true" />
    <item android:color="@color/assistant_outline" />
</selector>
